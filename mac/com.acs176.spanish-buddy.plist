<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.acs176.spanish-buddy</string>
  <key>ProgramArguments</key>
  <array>
    <!-- via bash: macOS lets bash-launched children read WhatsApp's DB, a bare python3 from launchd gets "authorization denied" -->
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/usr/bin/python3 -u /Users/adriancarbonell/personal/spanish-buddy/mac/send.py</string>
  </array>
  <!-- only sends WhatsApp messages to the server (it does the rest). Hourly: a run with nothing new is a cheap no-op -->
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>/tmp/spanish-buddy.log</string>
  <key>StandardErrorPath</key><string>/tmp/spanish-buddy.log</string>
</dict>
</plist>
