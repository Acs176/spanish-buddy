[Unit]
Description=Spanish Buddy: retry waiting words, write today's story

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/spanish-buddy.env
Environment=SB_DB=/srv/spanish-buddy/data/spanish-buddy.db
Environment=TZ=Europe/Madrid
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /srv/spanish-buddy/server.py tick
